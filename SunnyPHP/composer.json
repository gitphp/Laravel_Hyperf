{
    "name": "sunnyphp/framework",
    "description": "SunnyPHP is a lightweight PHP 8.4 micro-framework kernel SunnyPHP 轻量内核PHP框架.",
    "type": "library",
    "license": "MIT",
    "keywords": ["framework", "micro", "php84", "sunnyphp"],
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "SunnyPHP\\": "src/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SunnyPHP\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/sunny"
    ],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
